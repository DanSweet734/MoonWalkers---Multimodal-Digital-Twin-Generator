# Copy this file to .env and fill in values. .env is gitignored and Claude Code is blocked from reading it.
# Names only here; never put real values in this file.

# Hugging Face token (optional if you used `hf auth login`, which stores the token in your user profile)
HF_TOKEN=

# Where large local data lives (defaults to ./data)
MOONWALKERS_DATA_DIR=./data
