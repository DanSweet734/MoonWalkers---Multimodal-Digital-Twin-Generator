      "thumb_joint2",
      "index_joint1",
      "middle_joint1",
      "ring_joint1",
      "little_joint1",
      "thumb_joint0",
      "index_joint0",
      "middle_joint0",
      "ring_joint0",
      "little_joint0",
      "thumb_joint1",
      "thumb_joint3",
      "index_joint2",
      "middle_joint2",
      "ring_joint2",
      "little_joint2"
    ],
