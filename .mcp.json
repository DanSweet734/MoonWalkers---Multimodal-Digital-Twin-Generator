{
  "mcpServers": {
    "moonwalkers": {
      "command": "uv",
      "args": [
        "run",
        "--no-sync",
        "--directory",
        "${CLAUDE_PROJECT_DIR:-.}/backend",
        "python",
        "-m",
        "moonwalkers.mcp"
      ],
      "env": {
        "MOONWALKERS_GEN_ROOT": "${MOONWALKERS_GEN_ROOT:-}"
      },
      "timeout": 600000
    }
  }
}
