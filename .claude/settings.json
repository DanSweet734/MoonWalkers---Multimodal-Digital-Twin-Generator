{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git push -u origin *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(npm run *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git switch *)",
      "PowerShell(git checkout -b *)",
      "PowerShell(git push -u origin *)",
      "PowerShell(gh pr create *)",
      "PowerShell(gh pr view *)",
      "PowerShell(uv run pytest *)",
      "PowerShell(uv run ruff *)",
      "PowerShell(npm run *)"
    ],
    "ask": [
      "Bash(pip install *)",
      "Bash(uv add *)",
      "Bash(uv pip install *)",
      "Bash(uv tool install *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npx *)",
      "Bash(winget *)",
      "Bash(hf download *)",
      "PowerShell(pip install *)",
      "PowerShell(uv add *)",
      "PowerShell(uv pip install *)",
      "PowerShell(uv tool install *)",
      "PowerShell(npm install *)",
      "PowerShell(npm i *)",
      "PowerShell(npx *)",
      "PowerShell(winget *)",
      "PowerShell(hf download *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Bash(git push * main)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "PowerShell(git push * main)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git reset --hard *)"
    ]
  }
}
